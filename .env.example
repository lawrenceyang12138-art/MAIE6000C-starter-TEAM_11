APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/maie6000c
AI_SERVICE_URL=http://ai:8100
WORKER_POLL_SECONDS=2.0
WORKER_REQUEST_TIMEOUT_SECONDS=20.0
API_HOST_PORT=8000
AI_HOST_PORT=8100
# Windows note: host port 5432 sits inside the Hyper-V reserved range (5357-5657)
# and cannot be bound; keep 15432 unless you verified another free port.
POSTGRES_HOST_PORT=15432
# Server-side read-only mount allowlist (mount_id -> container path), JSON.
# Unknown mount_id values are rejected by the API. Adding a mount requires a
# config change plus a compose.yaml volume line and a restart.
SOURCE_MOUNTS={"corpus": "/source/corpus"}
EMBEDDING_ENABLED=true
EMBEDDING_MODEL_PATH=models/multilingual-e5-small
EMBEDDING_CPU_THREADS=4
SEARCH_REQUEST_TIMEOUT_SECONDS=10
SEARCH_KEYWORD_WEIGHT=0.65
SEARCH_SEMANTIC_WEIGHT=0.35
SEARCH_MAX_CANDIDATES=200
