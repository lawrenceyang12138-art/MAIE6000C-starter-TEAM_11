APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/maie6000c
AI_SERVICE_URL=http://ai:8100
WORKER_POLL_SECONDS=2.0
WORKER_REQUEST_TIMEOUT_SECONDS=20.0
API_HOST_PORT=8000
AI_HOST_PORT=8100
FRONTEND_HOST_PORT=3000
# Real API mode includes live model preparation progress. Set mock explicitly
# only for the labelled offline UI demonstration; failures never select it.
FRONTEND_DATA_MODE=api
# Docker mode uses the Nginx /api proxy to reach the api service.
FRONTEND_API_BASE_URL=/api
# Windows note: host port 5432 sits inside the Hyper-V reserved range (5357-5657)
# and cannot be bound; keep 15432 unless you verified another free port.
POSTGRES_HOST_PORT=15432
# Server-side read-only mount allowlist (mount_id -> container path), JSON.
# Unknown mount_id values are rejected by the API. Adding a mount requires a
# config change plus a compose.yaml volume line and a restart.
SOURCE_MOUNTS={"corpus": "/source/corpus"}
# Local API access. Compose derives browser origins from FRONTEND_HOST_PORT.
# Outside Compose, set API_ALLOWED_ORIGINS to a JSON list for custom UI ports.
# API_ALLOWED_HOSTS=["localhost","127.0.0.1","::1","api"]
# API_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
EMBEDDING_ENABLED=true
# First start downloads only the pinned public model, verifies SHA-256, then
# loads and warms it locally. Set false to prohibit model network preparation.
EMBEDDING_AUTO_PREPARE=true
EMBEDDING_DOWNLOAD_TIMEOUT_SECONDS=30
EMBEDDING_DOWNLOAD_RETRIES=3
EMBEDDING_MODEL_PATH=models/pplx-embed-v2-late-0.6b
EMBEDDING_CPU_THREADS=4
SEARCH_REQUEST_TIMEOUT_SECONDS=10
SEARCH_PAGE_NAVIGATION_ENABLED=true
SEARCH_KEYWORD_WEIGHT=0.65
SEARCH_SEMANTIC_WEIGHT=0.35
SEARCH_MAX_CANDIDATES=200
